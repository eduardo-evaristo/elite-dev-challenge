# Database — PostgreSQL via Docker (port 15432 maps to container 5432)
# Local dev:  postgres://postgres:password@localhost:15432/elite-dev-challenge
# Docker Compose: postgres://postgres:postgres@postgres:5432/elite-dev-challenge
DATABASE_URL=postgres://postgres:password@localhost:15432/elite-dev-challenge

# Auth
JWT_SECRET=your-jwt-secret-here

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins (required)
# Dev:  CORS_ORIGINS=http://localhost:5173
# Prod: CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Cookie domain (optional, blank = host-scoped)
# Set only when FE and BE share a parent domain, e.g. COOKIE_DOMAIN=.yourdomain.com
COOKIE_DOMAIN=

# Catalog module — external APIs
TMDB_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
TICKETMASTER_API_KEY=
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2

# Payment module — provider selection ('simulated' default)
PAYMENT_PROVIDER=simulated

# Tickets module — HMAC secret for ticket signatures (required, no default)
TICKET_SECRET=your-ticket-signing-secret-here
